{
  "name": "cusfit-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "prepare": "husky",
    "check:versions": "node .github/scripts/check-versions.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,css,html,md,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "oxlint": "1.85.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
